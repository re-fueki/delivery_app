<% content_for :title, "contact" %>
<section class="contact-page">

  <div class="contact-hero">
    <h1>お問い合わせ</h1>
    <p>
      Delivery App に関する質問・不具合・ご要望などがありましたら、
      お気軽にお問い合わせください。
    </p>
  </div>

  <div class="contact-container">

    <div class="contact-card">
      <h2>
        <i class="fa-solid fa-envelope"></i>
        メール
      </h2>

      <p>
        ご質問や不具合報告はこちら
      </p>

      <%= link_to "メールを送る",
                  new_contact_path,
                  class: "contact-btn" %>
    </div>

    <div class="contact-card">
      <h2>
        <i class="fa-brands fa-github"></i>
        GitHub
      </h2>

      <p>
        ソースコードや開発状況を確認できます
      </p>

      <a href="https://github.com/re-fueki/delivery_app" class="contact-btn">
        GitHubを見る
      </a>
    </div>

    <div class="contact-card">
      <h2>
        <i class="fa-solid fa-circle-question"></i>
        サポート
      </h2>

      <p>
        使い方や機能についてのヘルプ
      </p>

      <%= link_to "ヘルプを見る", help_path, class: "contact-btn" %>
    </div>

  </div>

</section>
